# Copy to .env and fill in. NEVER commit .env.  chmod 600 .env

# --- Schwab (developer portal app) ---
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# Must match the portal registration character-for-character:
SCHWAB_CALLBACK_URL=https://127.0.0.1:8443/oauth/callback

# --- Anthropic (AI strategy generation, Phase 4; optional until then) ---
ANTHROPIC_API_KEY=

# --- App ---
AUTOTRADER_DATA_DIR=~/.autotrader
AUTOTRADER_PORT=8484
AUTOTRADER_CALLBACK_PORT=8443

# --- Global safety limit defaults (also editable in the UI later) ---
AUTOTRADER_MAX_TOTAL_NOTIONAL=50000
AUTOTRADER_MAX_TOTAL_DAILY_LOSS=1000
AUTOTRADER_SIM_SLIPPAGE_BPS=1

# --- Phase 5.5 live plumbing probes: OFF by default. Turning this on lets
# /live-probe (not linked from the sidebar) place REAL orders against your
# real Schwab account, tiny quantities only, one manual confirmation per
# action. Leave LIVE_PROBE_ENABLED=false until you're deliberately ready to
# do a real 1-share round trip with the market open. ---
LIVE_PROBE_ENABLED=false
LIVE_PROBE_MAX_QTY=5
